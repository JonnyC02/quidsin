# Copy this file to .env for local (non-Docker) development.
# None of these are real secrets except GOOGLE_CLIENT_ID — DynamoDB Local
# accepts any placeholder AWS credentials. Real credentials are never
# committed to source control.

NODE_ENV=development
PORT=3001
WORKER_PORT=3002
WEB_ORIGIN=http://localhost:5173

DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=local
DYNAMODB_TABLE_NAME=quidsin
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

SESSION_DURATION_HOURS=168
SESSION_COOKIE_SECURE=false

# See docs/getting-started.md ("Setting up Google Sign-In") for how to
# create this. It's a public OAuth Client ID, safe to see here, but
# specific to your own Google Cloud project/deployment — there's no
# working default.
GOOGLE_CLIENT_ID=
