# Copy this file to .env for local (non-Docker) development.
# None of these are real secrets — DynamoDB Local accepts any placeholder
# AWS credentials. Real credentials are never committed to source control.

NODE_ENV=development
PORT=3001
WORKER_PORT=3002
WEB_ORIGIN=http://localhost:5173

DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=local
DYNAMODB_TABLE_NAME=quidsin
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

SESSION_DURATION_HOURS=168
SESSION_COOKIE_SECURE=false

PASSWORD_RESET_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password

# "console" logs the password reset link instead of sending an email —
# fine for local/self-hosted use. Set to "smtp" and fill in the SMTP_*
# vars below to send real emails.
NOTIFIER_DRIVER=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=noreply@example.com
